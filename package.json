{
  "name": "jadeer-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch-path=server --watch-path=src/content.js server/index.js --port=4000\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.js --port=4000",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "preview": "vite preview",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node server/seed.js",
    "db:studio": "prisma studio",
    "serve:lan": "vite build && node server/index.js --prod --port=80"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3",
    "vite": "^7.0.0"
  }
}
