# Copy to .env on the VPS:   cp .env.docker.example .env   then change every value.
# Generate random secrets with:   openssl rand -hex 32

# Database password (only used inside Docker)
POSTGRES_PASSWORD=change-me-long-random

# Secret for dashboard logins — long random string
JWT_SECRET=change-me-64-random-characters

# First dashboard login (created on first start only; change the password in the dashboard afterwards)
ADMIN_EMAIL=admin@jadeer.ly
ADMIN_PASSWORD=change-me-strong-password

# Docker network that Nginx Proxy Manager is attached to (on the iph VPS it is "proxy")
PROXY_NETWORK=proxy

# Port on the VPS (only needed if NPM forwards to the VPS IP instead of the container name)
APP_PORT=4010
# 127.0.0.1 = only this VPS can reach the port (recommended). Use 0.0.0.0 only if NPM runs on another machine.
APP_BIND=127.0.0.1
